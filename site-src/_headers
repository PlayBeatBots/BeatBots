# Cloudflare Pages response headers (copied to site/_headers by scripts/build_site.sh)
# Image files are named by content hash, so they can be cached for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable
# Sound kits and tracks rarely change; cache for a day, then revalidate.
/kits/*
  Cache-Control: public, max-age=86400, must-revalidate
/tracks/*.mp3
  Cache-Control: public, max-age=86400, must-revalidate
